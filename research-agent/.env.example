# PostHog Configuration
POSTHOG_PROJECT_ID=186875
POSTHOG_API_KEY=your_posthog_api_key_here

# Google Gemini (AI Synthesis)
GOOGLE_API_KEY=your_google_api_key_here

# GitHub Pages (linkable filterable report)
PUBLISH_GITHUB_PAGES=true
GITHUB_PAGES_URL=https://lesley-spec.github.io/uxdesignops
REPORT_OUTPUT_DIR=docs/research
REPORT_LOOKBACK_DAYS=90
REPORT_MAX_RESEARCH_ITEMS=100
POSTHOG_DROP_OFF_THRESHOLD=15
TOP_ISSUES_PER_WEEK=20

# Optional — Qualitative research sources
PENDO_API_KEY=
PENDO_SUBSCRIPTION_ID=5150941101162496
PENDO_REGION=US
PENDO_APP_ID=-323232
PENDO_MAX_FEEDBACK=200
PENDO_TOP_N=25
OUTSET_API_KEY=
OUTSET_API_BASE_URL=https://api.outset.ai
OUTSET_MAX_STUDIES=100
DOVETAIL_API_KEY=your_dovetail_api_token_here
DOVETAIL_API_TOKEN=your_dovetail_api_token_here
DOVETAIL_BASE_URL=https://dovetail.com
DOVETAIL_PAGE_SIZE=100
SLACK_WEBHOOK_URL=

# Freshworks / Freshdesk via BigQuery
# Console: https://console.cloud.google.com/bigquery?project=bt-impact-labs
BIGQUERY_ENABLED=true
BIGQUERY_PROJECT=bt-impact-labs
BIGQUERY_DATASET=prod-data-enablement
BIGQUERY_TICKETS_TABLE=datalake_freshdesk
BIGQUERY_LOOKBACK_DAYS=90
BIGQUERY_MAX_TICKETS=100
FRESHDESK_DOMAIN=

# Local BigQuery auth: gcloud auth application-default login
# GitHub Actions: set GCP_SA_KEY secret with service account JSON
